<form action = "/processar-cadastro "method="post" >
  <h2>CRIAR NOVA CONTA</h2>

<! -- CAMPO DE NOME COMPLETO -- >
  <label for = "Nome"> Nome </label>
  <input type= "text" id="nome" PLACEHOLDER = "Ex: João Silva" required>

 <! -- CAMPO DE EMAIL COM VALIDAÇÃO  -- > 
  <label for = "email"> E-mail </label>
  <input type= "email" id="email" PLACEHOLDER = "seuemail@gmail.com" required>

<! -- CAMPO DE SENHA COM CARACTERES OCULTOS  -- > 
  <label for = "senha"> Senha </label>
  <input type= "password" id="Senha" PLACEHOLDER = "Digite sua senha" required>

<! -- BOTÃO QUE DISPARA O ENVIO DE DADOS -- > 
  <button type = "submit"> Cadastrar </button>

</form>  
  
